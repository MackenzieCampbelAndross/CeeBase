{
  "product": "CeeBase",
  "version": "1.0.0",
  "identity": {
    "name": "CeeBase",
    "description": "Open source database and backend platform",
    "personality": [
      "Technical",
      "Modern",
      "Dependable",
      "Developer focused",
      "Minimal",
      "Infrastructure oriented"
    ]
  },
  "palette": {
    "primary": {
      "name": "Dark Azure",
      "hex": "#00638E",
      "role": "Primary brand colour, key indicators, primary CTA buttons"
    },
    "primary_deep": {
      "name": "Deep Azure",
      "hex": "#004A6B",
      "role": "Pressed state, dark gradient transition"
    },
    "primary_soft": {
      "name": "Soft Azure",
      "hex": "#8CB9CC",
      "role": "Gradient highlight, muted accent"
    },
    "light_azure": {
      "name": "Light Azure",
      "hex": "#BFD8E3",
      "role": "Soft accent, secondary labels, supporting surface"
    },
    "paper_white": {
      "name": "Paper White",
      "hex": "#FFFFFF",
      "role": "Primary light surface, text on primary, high-contrast foreground"
    },
    "onyx_deep": {
      "name": "Onyx Deep",
      "hex": "#000000",
      "role": "Deepest dark surface, base canvas"
    },
    "onyx_elevated": {
      "name": "Onyx Elevated",
      "hex": "#141414",
      "role": "Elevated dark surface, panels, cards, headers"
    },
    "charcoal": {
      "name": "Charcoal",
      "hex": "#2B2B2B",
      "role": "Secondary dark surface, borders, dividers, subtle boundaries"
    }
  },
  "gradients": {
    "brand": {
      "description": "Official CeeBase brand gradient",
      "stops": [
        { "color": "#000000", "position": "0%" },
        { "color": "#004A6B", "position": "35%" },
        { "color": "#00638E", "position": "70%" },
        { "color": "#8CB9CC", "position": "100%" }
      ],
      "css_linear_135": "linear-gradient(135deg, #000000 0%, #004A6B 35%, #00638E 70%, #8CB9CC 100%)",
      "css_linear_90": "linear-gradient(90deg, #000000 0%, #004A6B 35%, #00638E 70%, #8CB9CC 100%)"
    }
  },
  "typography": {
    "font_family_display": "Circular, 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "font_family_code": "ui-monospace, Menlo, Monaco, Consolas, 'Liberation Mono', monospace"
  },
  "radii": {
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  }
}
